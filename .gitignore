# Ignore image thumbnail files created by windows
Thumbs.db
# Ignore Finder view option files created by OS X
.DS_Store
# Ignore autogenerated source files
Externals/mGBA/version.c
Source/Core/Common/scmrev.h
# Ignore files output by build
/cmake-build-debug
/cmake-build-release
/[Bb]uild*/*
/[Bb]inary*/
/obj/
# Ignore files output by Android cmake build
/Source/Android/app/.cxx/
/libs/
# Ignore various files created by visual studio/msbuild
*.ipch
*.opensdf
*.sdf
*.suo
*.vcxproj.user
*.obj
*.tlog
*.VC.opendb
*.VC.db
.vs*/
/Source/enc_temp_folder/
# Ignore build info file created by QtCreator
CMakeLists.txt.user
# Ignore files created by posix people
*~
# Ignore vim swapfiles
*.swp
# Ignore emacs temp files
\#*\#
.\#*
# Ignore kdevelop files/dirs
*.kdev4
# Ignore IDEA/Clion files/dirs
.idea/
# Ignore Visual Studio Code's working dir
/.vscode/
# Ignore flatpak-builder's cache dir
.flatpak-builder
/Source/iOS/App/.cursor
/Source/iOS/App/.mcp.json
/Source/iOS/App/.package.resolved
/Source/iOS/App/Project/Scripts/__pycache__
/__pycache__
# Ignore Python bytecode caches anywhere in the tree (e.g. Tools/mcp/**/__pycache__)
__pycache__/
*.pyc
# Ignore setuptools egg-info generated by `uv sync` now that Tools/mcp/pyproject.toml
# declares [tool.uv] package = true (needed for `uv run icube-debug-mcp` to work).
*.egg-info/

# iCube: build output is generated, never tracked — the xcframework dir and the CMake build dirs.
# Build output is ignored — EXCEPT the packaged xcframework, which is tracked on
# purpose. Provenance consumes this repo as a submodule and PVDolphin links
# build/xcframework/PVlibDolphin.xcframework as a file reference that Xcode
# validates before any script phase runs, so a checkout without the binary
# cannot build (Provenance #3677 was reverted for exactly that). Refresh with
# `python3 BuildiOSXCFramework.py --platforms OS64 SIMULATORARM64 TVOS SIMULATOR_TVOS`
# and commit the result. Git will not descend into an ignored directory, so
# `/[Bb]uild*/` above is written as `/[Bb]uild*/*` — a negation under the
# directory form would be dead.
!/build/xcframework/
/build-*/

# Local release credentials (see Source/iOS/App/.env.sample)
.env

# subagent-driven-development scratch
.superpowers/
